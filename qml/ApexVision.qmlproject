import QmlProject 1.3

/*
 * Apex Industrial Vision Studio - QML user interface.
 *
 * Open this file in Qt Design Studio (File > Open Project) or Qt Creator.
 * Main.qml is the entry point; the screens live in screens/, the reusable parts in
 * ApexComponents/ and every colour / size in ApexTheme/Theme.qml.  All screens carry
 * sample data, so they render in the Design Studio canvas without the Python backend.
 * Run it live against real solutions with:  python qml_main.py
 */
Project {
    mainFile: "Main.qml"
    mainUiFile: "Main.qml"
    targetDirectory: "/opt/apexvision"
    qt6Project: true

    // lets `import ApexTheme 1.0` and `import ApexComponents 1.0` resolve from this folder
    importPaths: [ "." ]

    QmlFiles {
        directory: "."
    }

    JavaScriptFiles {
        directory: "."
    }

    ImageFiles {
        directory: "images"
    }

    Files {
        filter: "qtquickcontrols2.conf"
        files: [ "qtquickcontrols2.conf" ]
    }

    Files {
        filter: "qmldir"
        directory: "."
    }

    // design-time preview: size of the main window artboard
    Environment {
        QT_AUTO_SCREEN_SCALE_FACTOR: "1"
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
    }
}
