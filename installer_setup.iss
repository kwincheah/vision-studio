; Inno Setup Script for Apex Industrial Vision Studio
; Download Inno Setup from: https://jrsoftware.org/isdl.php
; Compile with: iscc installer_setup.iss

#define MyAppName "Apex Industrial Vision Studio"
#define MyAppVersion "1.0.0-beta.4"
#define MyAppPublisher "kwincheah"
#define MyAppURL "https://github.com/kwincheah/vision-studio"
#define MyAppExeName "ApexVisionStudio.exe"

[Setup]
; App Identity
AppId={{9B7E3E2A-8F12-4C10-912E-AC70C6F3D411}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
SetupIconFile=apex_vision\assets\app_icon.ico
UninstallDisplayIcon={app}\{#MyAppExeName}

; Installation Target Directory
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
DefaultGroupName={#MyAppName}

; Output Configuration
OutputDir=installer_output
OutputBaseFilename=ApexVisionStudio_Setup_v{#MyAppVersion}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern

; Privileges
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

; Association with .apex (Apex Vision Project) files
ChangesAssociations=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

; The main program is always installed. The converter carries PyTorch (large) and lets PyTorch .pt models run: untick to keep the install small.
[Components]
Name: "main"; Description: "Apex Industrial Vision Studio"; Types: full compact custom; Flags: fixed
Name: "pytorch"; Description: "PyTorch model support (.pt files) - adds about 370 MB to the download, 1.4 GB on disk"; Types: full

[Types]
Name: "full"; Description: "Full installation (with PyTorch .pt model support)"
Name: "compact"; Description: "Compact installation (ONNX models only)"
Name: "custom"; Description: "Custom installation"; Flags: iscustom

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "assoc_apex"; Description: "Associate .apex (Apex Vision Solution) files with Apex Vision Studio"; GroupDescription: "File Associations"

[Files]
; Dist files generated by PyInstaller --onedir mode
Source: "dist\ApexVisionStudio\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: main
; the converter program (built from ApexModelConverter.spec); the application finds it in {app}\converter
Source: "dist\ApexModelConverter\*"; DestDir: "{app}\converter"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist; Components: pytorch

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; Register .apex extension
Root: HKA; Subkey: "Software\Classes\.apex"; ValueType: string; ValueName: ""; ValueData: "ApexVisionStudio.Project"; Flags: uninsdeletevalue; Tasks: assoc_apex
Root: HKA; Subkey: "Software\Classes\ApexVisionStudio.Project"; ValueType: string; ValueName: ""; ValueData: "Apex Vision Solution Project"; Flags: uninsdeletekey; Tasks: assoc_apex
Root: HKA; Subkey: "Software\Classes\ApexVisionStudio.Project\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: assoc_apex
Root: HKA; Subkey: "Software\Classes\ApexVisionStudio.Project\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: assoc_apex

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
