; Inno Setup Script for Apex Industrial Vision Studio
; Download Inno Setup from: https://jrsoftware.org/isdl.php
; Compile with: iscc installer_setup.iss

#define MyAppName "Apex Industrial Vision Studio"
#define MyAppVersion "4.3.0"
#define MyAppPublisher "Apex Vision Technologies"
#define MyAppURL "https://github.com/kwincheah/vision-studio"
#define MyAppExeName "ApexVisionStudio.exe"

[Setup]
; App Identity
AppId={{9B7E3E2A-8F12-4C10-912E-AC70C6F3D411}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
SetupIconFile=vm_clone\assets\app_icon.ico
UninstallDisplayIcon={app}\{#MyAppExeName}

; Installation Target Directory
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
DefaultGroupName={#MyAppName}

; Output Configuration
OutputDir=installer_output
OutputBaseFilename=ApexVisionStudio_Setup_v{#MyAppVersion}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern

; Privileges
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

; Association with .vmp (Vision Master Project) files
ChangesAssociations=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "assoc_vmp"; Description: "Associate .vmp (Vision Master Solution) files with Apex Vision Studio"; GroupDescription: "File Associations"

[Files]
; Dist files generated by PyInstaller --onedir mode
Source: "dist\ApexVisionStudio\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; Register .vmp extension
Root: HKA; Subkey: "Software\Classes\.vmp"; ValueType: string; ValueName: ""; ValueData: "ApexVisionStudio.Project"; Flags: uninsdeletevalue; Tasks: assoc_vmp
Root: HKA; Subkey: "Software\Classes\ApexVisionStudio.Project"; ValueType: string; ValueName: ""; ValueData: "Apex Vision Solution Project"; Flags: uninsdeletekey; Tasks: assoc_vmp
Root: HKA; Subkey: "Software\Classes\ApexVisionStudio.Project\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: assoc_vmp
Root: HKA; Subkey: "Software\Classes\ApexVisionStudio.Project\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: assoc_vmp

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
